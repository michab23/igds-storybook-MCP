{
  "name": "igds-storybook-mcp",
  "version": "1.0.0",
  "description": "MCP server for IGDS Storybook component documentation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "scrape": "tsx src/scrape-all.ts",
    "http": "tsx src/http-server.ts",
    "inspector": "npx @modelcontextprotocol/inspector --transport stdio -- node dist/index.js"
  },
  "keywords": ["mcp", "storybook", "igds", "design-system"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.1.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
